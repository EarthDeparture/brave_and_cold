# Godot 4+ specific ignores
.godot/
/android/

brave-and-cold/demo/
tools/terrain/out/
shots/
tools/blender/__pycache__/
tools/blender/generated/hand_rig/*.blend[0-9]

brave-and-cold/build/

# raw downloaded audio (licences / size): only processed clips under assets/audio are tracked
audio_in/*
!audio_in/.gitkeep

tools/blender/generated/environment_detail/*.blend[0-9]

tools/blender/generated/road_detail/*.blend[0-9]

tools/blender/generated/hand_refinement/*.blend[0-9]
tools/blender/generated/route_detail/*.blend[0-9]

tools/blender/generated/route_identity/*.blend[0-9]

tools/blender/generated/lookout_opening/*.blend[0-9]

# Original procedural prop authoring: native packed source is tracked; exports live in assets.
tools/blender/generated/survival_props/*.blend[0-9]
tools/blender/generated/survival_props/*.glb
tools/blender/generated/survival_props/tex/
tools/blender/generated/fire_lookout.blend[0-9]
tools/blender/generated/fire_lookout.glb
tools/blender/generated/fire_lookout_geometry.json

# Raw local speech; final filtered audio and manifests are tracked.
tools/audio/generated/
tools/blender/generated/field_walkie/*.blend[0-9]

tools/blender/generated/first_week/*.blend[0-9]
tools/blender/first_week_build.log
tools/first_week_import.log

tools/blender/generated/clinic/*.blend[0-9]
tools/blender/generated/infected/*.blend[0-9]
tools/blender/clinic_build.log
tools/blender/infected_build.log

tools/blender/generated/wristwatch/*.blend[0-9]
tools/blender/watch_build.log

/tools/blender/generated/maintenance/*.blend[0-9]
/tools/blender/generated/maintenance/build.log
