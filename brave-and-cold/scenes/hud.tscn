[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
offset_left = 24.0
offset_top = 24.0
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StaminaLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Stamina: 100 / 100"

[node name="DrainButton" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Drain 25 stamina"

[node name="Hint" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Press to drain stamina; wait to watch it regenerate."

[connection signal="pressed" from="MarginContainer/VBoxContainer/DrainButton" to="." method="_on_drain_pressed"]
