    "public_d3_17.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 3.8099546485260767,
          "text": "Elliot Ward with the five o'clock bulletin."
        },
        {
          "start_s": 3.8099546485260767,
          "end_s": 6.739954648526077,
          "text": "Emergency crews now confirm it."
        },
        {
          "start_s": 6.739954648526077,
          "end_s": 12.109954648526077,
          "text": "People who die from these attacks get up again, and they attack the living."
        },
        {
          "start_s": 12.109954648526077,
          "end_s": 16.304954648526074,
          "text": "They have been seen on the town road and at the western junction."
        },
        {
          "start_s": 16.304954648526074,
          "end_s": 17.924954648526075,
          "text": "Avoid them."
        },
        {
          "start_s": 17.924954648526075,
          "end_s": 20.089954648526078,
          "text": "Secure your shelter."
        },
        {
          "start_s": 20.089954648526078,
          "end_s": 23.694954648526075,
          "text": "The power network is failing across the region."
        },
        {
          "start_s": 23.694954648526075,
          "end_s": 27.90498866213152,
          "text": "Fill containers with water and bring in fuel while you can."
        }
      ],
