        },
        {
          "start_s": 14.159954648526076,
          "end_s": 20.559954648526077,
          "text": "In the city, emergency rooms are busy with a fast seasonal fever; officials advise rest and"
        },
        {
          "start_s": 20.559954648526077,
          "end_s": 22.094954648526077,
          "text": "fluids."
        },
        {
          "start_s": 22.094954648526077,
          "end_s": 25.304954648526078,
          "text": "A clear, hard frost tonight."
        },
        {
          "start_s": 25.304954648526078,
          "end_s": 27.179954648526074,
          "text": "Back at midnight."
        }
      ],
