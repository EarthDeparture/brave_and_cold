          "text": "We have lost contact with the town crew."
        },
        {
          "start_s": 6.005,
          "end_s": 10.065,
          "text": "The last confirmed report placed them near the western junction."
        },
        {
          "start_s": 10.065,
          "end_s": 13.575,
          "text": "Do not go looking for them without a safe return route."
        },
        {
          "start_s": 13.575,
          "end_s": 17.674999999999997,
          "text": "Secure your shelter and gather supplies only when you need them."
