          "start_s": 0.4699546485260771,
          "end_s": 2.319954648526077,
          "text": "It is midnight."
        },
        {
          "start_s": 2.319954648526077,
          "end_s": 8.054954648526076,
          "text": "Mains power is failing across North Ridge, and this station is on reserve."
        },
        {
          "start_s": 8.054954648526076,
          "end_s": 13.357829648526076,
          "text": "The infected are moving through town, along the roads and around the store."
        },
        {
          "start_s": 13.357829648526076,
          "end_s": 17.652829648526076,
          "text": "Nurse Roy and the clinic staff left on foot this afternoon."
        },
        {
          "start_s": 17.652829648526076,
          "end_s": 20.887829648526075,
          "text": "No relief convoy is coming tonight."
        },
        {
          "start_s": 20.887829648526075,
          "end_s": 24.332829648526076,
          "text": "Keep your door secured and your fire small."
        },
        {
          "start_s": 24.332829648526076,
          "end_s": 27.857829648526078,
          "text": "If you can hear me, stay where you are."
        },
        {
          "start_s": 27.857829648526078,
          "end_s": 29.65283446712018,
          "text": "Back at six."
        }
