    "dispatch_d4_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 3.78,
          "text": "Kestrel Seven, this may be our last call."
        },
        {
          "start_s": 3.78,
          "end_s": 6.625,
          "text": "We cannot maintain the dispatch net."
        },
        {
          "start_s": 6.625,
          "end_s": 9.139999999999999,
          "text": "You are released from the assignment."
        },
        {
          "start_s": 9.139999999999999,
          "end_s": 14.469999999999999,
          "text": "Use the lookout, the tools and the supplies you can recover to keep yourself alive."
        },
        {
          "start_s": 14.469999999999999,
          "end_s": 18.644999999999996,
