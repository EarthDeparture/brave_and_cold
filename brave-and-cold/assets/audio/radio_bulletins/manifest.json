          "start_s": 8.554954648526078,
          "end_s": 15.154954648526077,
          "text": "Maintain your shelter, treat drinking water, and keep dry heating fuel in reserve."
        },
        {
          "start_s": 15.154954648526077,
          "end_s": 19.484954648526077,
          "text": "Infected groups have been reported along the town approaches."
        },
        {
          "start_s": 19.484954648526077,
          "end_s": 24.279954648526076,
          "text": "Travel with a return route and leave room to carry useful supplies."
        },
        {
          "start_s": 24.279954648526076,
          "end_s": 28.124988662131518,
          "text": "Do not spend your final reserves waiting for rescue."
        }
      ],
      "sha256": "dffacf16ae75920294a56d5305ace8d19af9b417ccf4e3bbaa6f640388c1683e",
      "seconds": 28.22498866213152,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "4400f0a17eaaf69cb19edb4aec1994a5657bc4364241de76cf5e8f07081692db"
    },
    "public_d4_17.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 3.2849546485260768,
          "text": "This is the five o'clock bulletin."
        },
        {
          "start_s": 3.2849546485260768,
          "end_s": 8.764954648526077,
          "text": "We have fewer working contacts and cannot verify the condition of every road."
        },
        {
          "start_s": 8.764954648526077,
          "end_s": 12.889954648526077,
          "text": "Silence from a community does not mean that it is safe."
        },
        {
          "start_s": 12.889954648526077,
          "end_s": 19.109954648526077,
          "text": "Store doors, clinic grounds and traffic queues remain dangerous places to linger."
        },
        {
          "start_s": 19.109954648526077,
          "end_s": 22.554954648526078,
          "text": "There will be no scheduled supply deliveries."
        },
        {
          "start_s": 22.554954648526078,
          "end_s": 27.554965986394556,
          "text": "Concentrate on water, warmth and a defensible place to rest."
        }
      ],
      "sha256": "d964a4214d728cfb0853156578fc9d1390722124a134241a327b856d86e01901",
      "seconds": 27.654965986394558,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "4168cbe6db1a6b18b790719e131e10d6370ff25cf94610bf806d963dd9cbea22"
    },
    "public_d4_24.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 2.319954648526077,
          "text": "It is midnight."
        },
        {
          "start_s": 2.319954648526077,
          "end_s": 4.104954648526077,
          "text": "Elliot Ward."
        },
        {
          "start_s": 4.104954648526077,
          "end_s": 6.509954648526077,
          "text": "We are on reserve power."
        },
        {
          "start_s": 6.509954648526077,
          "end_s": 12.189954648526077,
          "text": "I kept the regular times because someone might still be waiting for a familiar voice."
        },
        {
          "start_s": 12.189954648526077,
          "end_s": 16.357829648526074,
          "text": "There are no dependable services behind these bulletins."
        },
        {
          "start_s": 16.357829648526074,
          "end_s": 19.100704648526076,
          "text": "Keep your local equipment working."
        },
        {
          "start_s": 19.100704648526076,
          "end_s": 22.225704648526076,
          "text": "A voice is not a promise of rescue."
        },
        {
          "start_s": 22.225704648526076,
          "end_s": 24.790748299319727,
          "text": "We will try again at six."
        }
      ],
      "sha256": "3ed4e3f03d4fc92301a26794a5df498b5f6b9358dbd999a004026af38385a35e",
      "seconds": 24.89074829931973,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "0bbd9b7cbea0399d8aa18ca02c0b348927c7cb5485ef526acc5f2217d4d7217b"
    },
    "public_d5_06.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 2.9999546485260766,
          "text": "Good morning from North Ridge."
        },
        {
          "start_s": 2.9999546485260766,
          "end_s": 7.629954648526077,
          "text": "This is expected to be our final day of scheduled broadcasting."
        },
        {
          "start_s": 7.629954648526077,
          "end_s": 10.874954648526076,
          "text": "Our reserve power is nearly exhausted."
        },
        {
          "start_s": 10.874954648526076,
          "end_s": 15.924954648526077,
          "text": "There is still no confirmed relief operation for the northern communities."
        },
        {
          "start_s": 15.924954648526077,
          "end_s": 21.074954648526077,
          "text": "Maintain water, warmth and food before considering another journey."
        },
        {
          "start_s": 21.074954648526077,
          "end_s": 27.184988662131516,
          "text": "We intend to return at noon, five, and midnight if the transmitter holds."
        }
      ],
      "sha256": "4587fa3b71a720931e82a1f1abd5061a077f0518d0ded9357274bdec3d5fabf3",
      "seconds": 27.284988662131518,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "80a0f231069be44fa626ddfd18bffaf8512286b16af42d54d05cc2cdf013c8ae"
    },
    "public_d5_12.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 2.169954648526077,
          "text": "It is noon."
        },
        {
          "start_s": 2.169954648526077,
          "end_s": 8.359954648526077,
          "text": "This morning's notice remains unchanged: today is expected to be the final operating day for this"
        },
        {
          "start_s": 8.359954648526077,
          "end_s": 9.929954648526078,
          "text": "station."
        },
        {
          "start_s": 9.929954648526078,
          "end_s": 13.129954648526077,
          "text": "No relief service has been confirmed."
        },
        {
          "start_s": 13.129954648526077,
          "end_s": 20.844954648526077,
          "text": "Conserve medical supplies, keep drinking water safe, and prepare your shelter for another cold night."
        },
        {
          "start_s": 20.844954648526077,
          "end_s": 25.854965986394557,
          "text": "We intend to make the five o'clock report and a final midnight signoff."
        }
      ],
      "sha256": "90eeb38985d2599ef25b9f96392d54cede39915e5aef7921186f3825987b83ec",
      "seconds": 25.95496598639456,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "2d7f36bd53b3b4e108712ff688875a01f2579d119af0702d20846426ebf0e25c"
    },
    "public_d5_17.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 3.2849546485260768,
          "text": "This is the five o'clock bulletin."
        },
        {
          "start_s": 3.2849546485260768,
          "end_s": 6.924954648526077,
          "text": "We have no new verified outside reports."
        },
        {
          "start_s": 6.924954648526077,
          "end_s": 11.514954648526077,
          "text": "The transmitter has enough reserve for the planned midnight signoff."
        },
        {
          "start_s": 11.514954648526077,
          "end_s": 15.504954648526077,
          "text": "Do not treat the silence afterwards as an all clear."
        },
        {
          "start_s": 15.504954648526077,
          "end_s": 18.714954648526078,
          "text": "Continue the precautions you already know."
        },
        {
          "start_s": 18.714954648526078,
          "end_s": 24.059954648526077,
          "text": "Keep a route home, keep dry fuel, and help the people you can reach without abandoning"
        },
        {
          "start_s": 24.059954648526077,
          "end_s": 25.879954648526077,
          "text": "your own shelter."
        }
      ],
      "sha256": "c17c75dd6743606b589daa791dc1833c34cc9e994b96c8e895d47f2bab14f1d0",
      "seconds": 25.97995464852608,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "b9a48e58c30662e6627b49d1a54477162c4d339db004de06d8c07518d1b39488"
    },
    "public_d5_24.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 2.319954648526077,
          "text": "It is midnight."
        },
        {
          "start_s": 2.319954648526077,
          "end_s": 6.069954648526077,
          "text": "Elliot Ward, North Ridge Public Radio."
        },
        {
          "start_s": 6.069954648526077,
          "end_s": 9.454954648526076,
          "text": "This is our final scheduled transmission."
        },
        {
          "start_s": 9.454954648526076,
          "end_s": 12.384954648526076,
          "text": "No bulletin will follow at six."
        },
        {
          "start_s": 12.384954648526076,
          "end_s": 17.669954648526076,
          "text": "The names on our call sheet are still here, even when nobody answers."
        },
        {
          "start_s": 17.669954648526076,
          "end_s": 22.714954648526078,
          "text": "Keep your shelter secure, your water clean and your people warm."
        },
        {
          "start_s": 22.714954648526078,
          "end_s": 26.529954648526076,
          "text": "You have already survived without dependable help."
        },
        {
          "start_s": 26.529954648526076,
          "end_s": 28.829977324263037,
          "text": "North Ridge signing off."
        }
      ],
      "sha256": "18861ab15852f6ebe7203502487f26284d37b110882f47efdc83c36ec68ac216",
      "seconds": 28.92997732426304,
      "sample_rate": 22050,
      "device": "public",
      "voice": "Microsoft David Desktop",
      "rate": -1,
      "text_sha256": "05e58f2f2d9be6f37aaeccf8d361af2560c7706194a91c142ce1cff4fae6ec44"
    },
    "dispatch_d1_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 3.335,
          "text": "Kestrel Seven, June at dispatch."
        },
        {
          "start_s": 3.335,
          "end_s": 4.8549999999999995,
          "text": "Good signal."
        },
        {
          "start_s": 4.8549999999999995,
          "end_s": 10.75,
          "text": "Inspect the transfer cabinet; your replacement relay is reserved at North Ridge Supply."
        },
        {
          "start_s": 10.75,
          "end_s": 15.02,
          "text": "Mara left timber markers and a crew cache on the access track."
        },
        {
          "start_s": 15.02,
          "end_s": 18.08,
          "text": "Check the labelled feeder before isolating it."
        },
        {
          "start_s": 18.08,
          "end_s": 20.554999999999996,
          "text": "The lookout is yours for the week."
        },
        {
          "start_s": 20.554999999999996,
          "end_s": 23.099999999999998,
          "text": "Read the desk log before travelling."
        }
      ],
      "sha256": "5bb602bd96caf45b1958a7f4beaecf1bddface95a4876d9721a77ddb0e26a99a",
      "seconds": 23.174965986394557,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "7fdb6d39fe8ac9ba33d8c19582558b07b699170ac1577eaabee5a53efff3902c"
    },
    "dispatch_d1_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 6.845,
          "text": "Mara says the crew cache has drinking water and dressings."
        },
        {
          "start_s": 6.845,
          "end_s": 10.235,
          "text": "It is a reserve, not tomorrow's delivery."
        },
        {
          "start_s": 10.235,
          "end_s": 13.549999999999999,
          "text": "The replacement relay is at North Ridge Supply."
        },
        {
          "start_s": 13.549999999999999,
          "end_s": 17.319999999999997,
          "text": "Take the logging track and leave daylight for the climb back."
        },
        {
          "start_s": 17.319999999999997,
          "end_s": 20.38,
          "text": "Your handset monitors public news too."
        },
        {
          "start_s": 20.38,
          "end_s": 23.08,
          "text": "Put it in its charger between trips."
        }
      ],
      "sha256": "57c58aeb6feaaa3b81dcb4a367bb70a782ab8614f60814e020b89cf6b630036d",
      "seconds": 23.154965986394558,
      "sample_rate": 22050,
      "device": "dispatch",
