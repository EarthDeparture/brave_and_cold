    "public_d3_12.wav": {
      "captions": [
        {
          "start_s": 0.4699546485260771,
          "end_s": 2.169954648526077,
          "text": "It is noon."
        },
        {
          "start_s": 2.169954648526077,
          "end_s": 4.444954648526077,
          "text": "This is not a recap."
        },
        {
          "start_s": 4.444954648526077,
          "end_s": 9.844954648526077,
          "text": "Shortly after ten, people at the clinic were attacked by patients who had arrived from the"
        },
        {
          "start_s": 9.844954648526077,
          "end_s": 11.264954648526077,
          "text": "city."
        },
        {
          "start_s": 11.264954648526077,
          "end_s": 13.654954648526077,
          "text": "Several were badly hurt."
        },
        {
          "start_s": 13.654954648526077,
          "end_s": 17.564954648526076,
          "text": "Some witnesses say the attackers had already died."
        },
        {
          "start_s": 17.564954648526076,
          "end_s": 20.904954648526076,
          "text": "Stay away from the clinic and the town road."
        },
        {
          "start_s": 20.904954648526076,
          "end_s": 22.874954648526078,
          "text": "Lock your doors."
        },
        {
          "start_s": 22.874954648526078,
          "end_s": 26.619954648526075,
          "text": "Do not try to help anyone acting violently."
        },
        {
          "start_s": 26.619954648526075,
          "end_s": 28.38498866213152,
          "text": "More at five."
        }
      ],
