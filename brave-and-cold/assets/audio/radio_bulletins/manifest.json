      "rate": 0,
      "text_sha256": "adf91f0a75611d9112e90ae148e58c371f38a409f9c7765134b5eb6e2d4a17ed"
    },
    "dispatch_d1_20.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 3.82,
          "text": "Kestrel Seven, June's last check tonight."
        },
        {
          "start_s": 3.82,
          "end_s": 6.39,
          "text": "Mara made it back to the junction."
        },
        {
          "start_s": 6.39,
          "end_s": 10.95,
          "text": "We heard the distant reports, but your assignment still stands."
        },
        {
          "start_s": 10.95,
          "end_s": 12.915,
          "text": "Stay at the lookout."
        },
        {
          "start_s": 12.915,
          "end_s": 15.844999999999999,
          "text": "Feed the stove and charge the handset."
        },
        {
          "start_s": 15.844999999999999,
          "end_s": 20.365,
          "text": "If somebody in the city is not answering, try again tomorrow."
        },
        {
          "start_s": 20.365,
          "end_s": 22.24,
          "text": "We will check in at eight."
        }
      ],
      "sha256": "aeb2810c04688367149d43208e477bff838064711f2330599a33abb9db50b0ec",
      "seconds": 22.314965986394558,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "2054052dcc1d1fad6f90ff2551f1d35cabd5327ebb719ba0e23b6054dca394db"
    },
    "dispatch_d2_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 5.04,
          "text": "This has reached our region."
        },
        {
          "start_s": 5.04,
          "end_s": 10.86,
          "text": "Mara is taking the town crew towards the clinic service yard; the waiting room is crowded."
        },
        {
          "start_s": 10.86,
          "end_s": 14.004999999999999,
          "text": "Keep clear unless supplies force a visit."
        },
        {
          "start_s": 14.004999999999999,
          "end_s": 18.29,
          "text": "Collect your reserved relay if it is safe, then come home."
        },
        {
          "start_s": 18.29,
          "end_s": 21.9,
          "text": "Take the handset and leave enough daylight for the stairs."
        }
      ],
      "sha256": "619f61ddf87979edb5c7490561646c635f85e28b772ae8692997f33cae81d8c6",
      "seconds": 21.974965986394558,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "95384a80c5ff2d6306858c19773a3252540fb02830a1385de780121a5e66510a"
    },
    "dispatch_d2_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 5.22,
          "text": "The supply truck is cancelled."
        },
        {
          "start_s": 5.22,
          "end_s": 7.59,
          "text": "Do not wait beside the road."
        },
        {
          "start_s": 7.59,
          "end_s": 11.735,
          "text": "Mara asked me to tell you the marked cache is yours if you need it."
        },
        {
          "start_s": 11.735,
          "end_s": 14.045,
          "text": "Nothing more is being sent."
        },
        {
          "start_s": 14.045,
          "end_s": 16.505,
          "text": "Keep the lookout as your base."
        },
        {
          "start_s": 16.505,
          "end_s": 21.40503401360544,
          "text": "Commission the relay if you can, but water and heating fuel come first."
        }
      ],
      "sha256": "adad076c24b67f7457f249a2166d296a6d8fedd6bafa699cac2c2e49d838bfdd",
      "seconds": 21.48,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "77dc27255a87c0178b23c905e9cb9a2f720ad8ce054484573492d9402ec94678"
    },
    "dispatch_d2_20.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 6.17,
          "text": "Mara's last call was from the western junction."
        },
        {
          "start_s": 6.17,
          "end_s": 8.86,
          "text": "Then the town crew stopped answering."
        },
        {
          "start_s": 8.86,
          "end_s": 12.24,
          "text": "Do not go searching without water and a way home."
        },
        {
          "start_s": 12.24,
          "end_s": 14.82,
          "text": "I know you have people in the city."
        },
        {
          "start_s": 14.82,
          "end_s": 17.604999999999997,
          "text": "We cannot get a message through there either."
        },
        {
          "start_s": 17.604999999999997,
          "end_s": 19.595,
          "text": "Secure the lookout."
        },
        {
          "start_s": 19.595,
          "end_s": 21.685034013605442,
          "text": "I will try you in the morning."
        }
      ],
      "sha256": "8519f2ac6404d1e18d5697bbb550cd18335ad4220226a1aca5afcae397f34d50",
      "seconds": 21.76,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "ec4d4260bf1ec73220dd1fda9cfeca0282905fabda1ea903c561e1b9a8e04ba2"
    },
    "dispatch_d3_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 4.995,
          "text": "We cannot send anyone."
        },
        {
          "start_s": 4.995,
          "end_s": 9.889999999999999,
          "text": "Nurse Roy left a notice at the clinic; supplies are still on its shelves, but do"
        },
        {
          "start_s": 9.889999999999999,
          "end_s": 11.934999999999999,
          "text": "not expect staff."
        },
        {
          "start_s": 11.934999999999999,
          "end_s": 15.35,
          "text": "Your installation only supports local equipment."
        },
        {
          "start_s": 15.35,
          "end_s": 18.095,
          "text": "Repairing it will not restore the town."
        },
        {
          "start_s": 18.095,
          "end_s": 21.694999999999997,
          "text": "Keep water, heating fuel and food in reserve."
        },
        {
          "start_s": 21.694999999999997,
          "end_s": 24.55501133786848,
          "text": "Listen for public reports when you can."
        }
      ],
      "sha256": "2cc7febaa08294e7a186c8bbfc6cf42db395628c381a2031647a4fd80d14be21",
      "seconds": 24.629977324263038,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "9964aced158a3c1722bf64a4b9dbd821d33a0648bb47971845e9dcf113d1ef5f"
    },
    "dispatch_d3_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 6.92,
          "text": "If mains have failed, switch off lights you do not need."
        },
        {
          "start_s": 6.92,
          "end_s": 10.885,
          "text": "Isolating the labelled crew spur reduces standby drain."
        },
        {
          "start_s": 10.885,
          "end_s": 14.424999999999999,
          "text": "Charge the handset while local power lasts."
        },
        {
          "start_s": 14.424999999999999,
          "end_s": 16.554999999999996,
          "text": "Mara has not answered."
        },
        {
          "start_s": 16.554999999999996,
          "end_s": 20.974999999999998,
          "text": "I am leaving her channel open, but you should not spend your last reserves waiting with"
        },
        {
          "start_s": 20.974999999999998,
          "end_s": 22.099999999999998,
          "text": "me."
        },
        {
          "start_s": 22.099999999999998,
          "end_s": 24.38,
          "text": "Shelter and water first."
