          "start_s": 0.18,
          "end_s": 2.9899999999999998,
          "text": "Kestrel Seven, dispatch."
        },
        {
          "start_s": 2.9899999999999998,
          "end_s": 6.319999999999999,
          "text": "There are very few of us left answering this net."
        },
        {
          "start_s": 6.319999999999999,
          "end_s": 9.605,
          "text": "Keep treating water and securing your shelter."
        },
        {
