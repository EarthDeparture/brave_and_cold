      "rate": 0,
      "text_sha256": "7fdb6d39fe8ac9ba33d8c19582558b07b699170ac1577eaabee5a53efff3902c"
    },
    "dispatch_d1_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 6.845,
          "text": "Mara says the crew cache has drinking water and dressings."
        },
        {
          "start_s": 6.845,
          "end_s": 10.235,
          "text": "It is a reserve, not tomorrow's delivery."
        },
        {
          "start_s": 10.235,
          "end_s": 13.549999999999999,
          "text": "The replacement relay is at North Ridge Supply."
        },
        {
          "start_s": 13.549999999999999,
          "end_s": 17.319999999999997,
          "text": "Take the logging track and leave daylight for the climb back."
        },
        {
          "start_s": 17.319999999999997,
          "end_s": 20.38,
          "text": "Your handset monitors public news too."
        },
        {
          "start_s": 20.38,
          "end_s": 23.08,
          "text": "Put it in its charger between trips."
        }
      ],
      "sha256": "57c58aeb6feaaa3b81dcb4a367bb70a782ab8614f60814e020b89cf6b630036d",
      "seconds": 23.154965986394558,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "adf91f0a75611d9112e90ae148e58c371f38a409f9c7765134b5eb6e2d4a17ed"
    },
    "dispatch_d1_20.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 3.82,
          "text": "Kestrel Seven, June's last check tonight."
        },
        {
          "start_s": 3.82,
          "end_s": 5.495,
          "text": "Good first day."
        },
        {
          "start_s": 5.495,
          "end_s": 10.295,
          "text": "Mara made it back to the junction and says the timber pull-off is marked for you."
        },
        {
          "start_s": 10.295,
          "end_s": 13.655,
          "text": "The supply truck is booked for tomorrow afternoon."
        },
        {
          "start_s": 13.655,
          "end_s": 17.674999999999997,
          "text": "Feed the stove and put the handset on its charger before bed."
        },
        {
          "start_s": 17.674999999999997,
          "end_s": 22.025,
          "text": "If anything on the list is unfinished, it keeps until morning."
        },
        {
          "start_s": 22.025,
          "end_s": 23.9,
          "text": "We will check in at eight."
        }
      ],
      "sha256": "f5e8492f810efed79ac8ea1e1431e1ce22546d2732d18a8d7e588d561b28f08f",
      "seconds": 23.974965986394558,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "971ba77956fec57d48ef865f1c79ccc7ada2202e80d9ee9ff8c309fff81efbf8"
    },
    "dispatch_d2_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 4.2749999999999995,
          "text": "Morning."
        },
        {
          "start_s": 4.2749999999999995,
          "end_s": 9.23,
          "text": "If you still need the replacement relay, it is waiting at North Ridge Supply."
        },
        {
          "start_s": 9.23,
          "end_s": 13.705,
          "text": "The grader is on the logging road, so watch for it at the junction."
        },
        {
          "start_s": 13.705,
          "end_s": 17.244999999999997,
          "text": "Mara's crew is clearing deadfall near town today."
        },
        {
          "start_s": 17.244999999999997,
          "end_s": 20.484999999999996,
          "text": "Check the labelled feeder and keep the stove going."
        },
        {
          "start_s": 20.484999999999996,
          "end_s": 24.51002267573696,
          "text": "Take the handset, and leave daylight for the climb back."
        }
      ],
      "sha256": "56515a3f0f9060725f72f50e1414413401ea3326f5c014c63a40594d9247603e",
      "seconds": 24.58498866213152,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "c7ee475bd5308d9e73534e21a6c102cedab29f8045b30cf70b7729329966c6e3"
    },
    "dispatch_d2_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 4.984999999999999,
          "text": "Bad news on the delivery."
        },
        {
          "start_s": 4.984999999999999,
          "end_s": 9.49,
          "text": "The truck is held at the depot; the driver called in sick, along with half the"
        },
        {
          "start_s": 9.49,
          "end_s": 10.735,
          "text": "yard."
        },
        {
          "start_s": 10.735,
          "end_s": 13.004999999999999,
          "text": "Everybody has this fever."
        },
        {
          "start_s": 13.004999999999999,
          "end_s": 15.04,
          "text": "It should run tomorrow."
        },
        {
          "start_s": 15.04,
          "end_s": 17.65,
          "text": "Mara's cache is there if you need it."
        },
        {
          "start_s": 17.65,
          "end_s": 22.099999999999998,
          "text": "Commission the relay if you can, and do not wait beside the road."
        }
      ],
      "sha256": "833b1e0d283882153b8149bcdcbcdcd9d291272fabfc39a74198efa31eb637e9",
      "seconds": 22.174965986394557,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "73d693207e16d1c3573a91d204149a5f59d0f033bdd3a6b64ec52014efb41db7"
    },
    "dispatch_d2_20.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 4.52,
          "text": "End of day two."
        },
        {
          "start_s": 4.52,
          "end_s": 9.06,
          "text": "Head office has gone quiet, and I could not get through to the city this evening;"
        },
        {
          "start_s": 9.06,
          "end_s": 10.934999999999999,
          "text": "the lines are jammed."
        },
        {
          "start_s": 10.934999999999999,
          "end_s": 12.785,
          "text": "Probably nothing."
        },
        {
          "start_s": 12.785,
          "end_s": 15.854999999999999,
          "text": "Mara's crew is staying in town overnight."
        },
        {
          "start_s": 15.854999999999999,
          "end_s": 20.24,
          "text": "Stay at the lookout, feed the stove and charge the handset."
        },
        {
          "start_s": 20.24,
          "end_s": 24.064999999999998,
          "text": "If you have family in the city, try them in the morning."
        },
        {
          "start_s": 24.064999999999998,
          "end_s": 25.939999999999998,
          "text": "We will check in at eight."
        }
      ],
      "sha256": "0c674f44bfd7eee919562d60ce6ef5394941683b3a1a7223dfb3303554627224",
      "seconds": 26.014965986394557,
      "sample_rate": 22050,
      "device": "dispatch",
