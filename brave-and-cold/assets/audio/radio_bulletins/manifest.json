      "rate": 0,
      "text_sha256": "13e7f342c97be45ddbe1b2fc49e1022fa1d92b777dc7f757262c07747f3369d9"
    },
    "dispatch_d3_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 5.2,
          "text": "You heard the overnight news."
        },
        {
          "start_s": 5.2,
          "end_s": 7.91,
          "text": "Head office still is not answering."
        },
        {
          "start_s": 7.91,
          "end_s": 12.639999999999999,
          "text": "Cars came up from the city in the night, and the clinic is overwhelmed, so Mara"
        },
        {
          "start_s": 12.639999999999999,
          "end_s": 14.979999999999999,
          "text": "took the town crew to help."
        },
        {
          "start_s": 14.979999999999999,
          "end_s": 17.185,
          "text": "Stop work for today."
        },
        {
          "start_s": 17.185,
          "end_s": 22.185,
          "text": "Stay near the lookout, keep the handset on you, and do not go into town unless"
        },
        {
          "start_s": 22.185,
          "end_s": 23.575011337868478,
          "text": "you have to."
        }
      ],
      "sha256": "b698725e6caaddb57cbf4c7289d92dbaae48d8af333a363d0d84fa0dde6bf6b6",
      "seconds": 23.649977324263038,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "cc1800d1a002aa17325bb3476208578eca88e491a55d91f56ff230599b7aa410"
    },
    "dispatch_d3_14.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 5.755,
          "text": "Something has gone very wrong at the clinic."
        },
        {
          "start_s": 5.755,
          "end_s": 8.385,
          "text": "Mara called from the service yard."
        },
        {
          "start_s": 8.385,
          "end_s": 11.86,
          "text": "People were bitten, and one of the dead got up."
        },
        {
          "start_s": 11.86,
          "end_s": 14.065,
          "text": "Police are not answering."
        },
        {
          "start_s": 14.065,
          "end_s": 17.38,
          "text": "She is moving the crew out to the western junction."
        },
        {
          "start_s": 17.38,
          "end_s": 19.324999999999996,
          "text": "Stay out of town."
        },
        {
          "start_s": 19.324999999999996,
          "end_s": 21.365,
          "text": "Lock the lookout door."
        },
        {
          "start_s": 21.365,
          "end_s": 23.85501133786848,
          "text": "Bring in water and firewood now."
        }
      ],
      "sha256": "cae7c85e578c6198ae442310940df0e315576c0577d660668c8c1200be8bcfb2",
      "seconds": 23.92997732426304,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "9543f813fdf1fcfc46ebea68746ff2a733d1dfe863f8b680231a6eca979efde6"
    },
    "dispatch_d3_20.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 2.795,
          "text": "Kestrel Seven, June."
        },
        {
          "start_s": 2.795,
          "end_s": 6.17,
          "text": "Mara's last call was from the western junction."
        },
        {
          "start_s": 6.17,
          "end_s": 8.58,
          "text": "Then the crew stopped answering."
        },
        {
          "start_s": 8.58,
          "end_s": 13.665,
          "text": "The mains are failing all over the district; switch off lights you do not need."
        },
        {
          "start_s": 13.665,
          "end_s": 16.784999999999997,
          "text": "I tried the city exchange for your sister."
        },
        {
          "start_s": 16.784999999999997,
          "end_s": 18.694999999999997,
          "text": "Nothing gets through."
        },
        {
          "start_s": 18.694999999999997,
          "end_s": 21.845,
          "text": "Secure the lookout and keep the stove going."
        },
        {
          "start_s": 21.845,
          "end_s": 24.789999999999996,
          "text": "Do not go looking for anyone in the dark."
        },
        {
          "start_s": 24.789999999999996,
          "end_s": 26.69501133786848,
          "text": "I will try you at eight."
        }
      ],
      "sha256": "c66cd7d3dd9ce24a88f9697cb760e88bf85a38eefabd3dc91de65cd481c99cf4",
      "seconds": 26.76997732426304,
      "sample_rate": 22050,
      "device": "dispatch",
      "voice": "Microsoft Zira Desktop",
      "rate": 0,
      "text_sha256": "515d7c5f2c8ef9aca5e8777937a9acd0908fc74dae0742a5ce93a16c648d22a5"
    },
    "dispatch_d4_08.wav": {
      "captions": [
        {
          "start_s": 0.18,
          "end_s": 1.965,
          "text": "Kestrel Seven."
        },
        {
          "start_s": 1.965,
          "end_s": 3.38,
          "text": "June."
        },
        {
          "start_s": 3.38,
          "end_s": 5.805,
          "text": "I cannot maintain this net."
        },
        {
          "start_s": 5.805,
          "end_s": 8.32,
          "text": "You are released from the assignment."
        },
        {
          "start_s": 8.32,
          "end_s": 11.95,
          "text": "Use the lookout and the tools to keep yourself alive."
        },
        {
          "start_s": 11.95,
          "end_s": 16.575,
          "text": "The public station is independent; it may still be broadcasting."
        },
        {
          "start_s": 16.575,
          "end_s": 20.904999999999998,
          "text": "If Mara reaches you, tell her I stayed as long as I could."
        },
        {
          "start_s": 20.904999999999998,
          "end_s": 22.935,
          "text": "Do not wait for us."
        },
        {
          "start_s": 22.935,
          "end_s": 24.479999999999997,
          "text": "Dispatch out."
        }
      ],
      "sha256": "609696785b853d07bda7a1252e8f6eb886c4c652baa7d0162f50edf84aef12ba",
      "seconds": 24.554965986394556,
